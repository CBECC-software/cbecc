REGEDIT
; This .REG file may be used by your SETUP program.
;   If a SETUP program is not available, the entries below will be
;   registered in your InitInstance automatically with a call to
;   CWinApp::RegisterShellFileTypes and COleObjectFactory::UpdateRegistryAll.

HKEY_CLASSES_ROOT\.cibd28 = CBECC-28.Document
HKEY_CLASSES_ROOT\.cibd28x = CBECC-28.Document
HKEY_CLASSES_ROOT\.ribd28 = CBECC-28.Document
HKEY_CLASSES_ROOT\.ribd28x = CBECC-28.Document
HKEY_CLASSES_ROOT\CBECC-28.Document\shell\open\command = CBECC-28.EXE %1
HKEY_CLASSES_ROOT\CBECC-28.Document\shell\open\ddeexec = [open("%1")]
HKEY_CLASSES_ROOT\CBECC-28.Document\shell\open\ddeexec\application = CBECC-28
    ; note: the application is optional
    ;  (it defaults to the app name in "command")

HKEY_CLASSES_ROOT\CBECC-28.Document = CBECC-28 Document
